<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
  <meta charset="UTF-8"/>
  <title>Payment Preview</title>
  <link rel="stylesheet" th:href="@{/css/style.css}">
</head>
<body>

<header class="nav">
  <div class="nav-inner">
    <div class="brand">
      Disney Ticketing
      <small>Payment Preview</small>
    </div>
    <a class="btn btn-outline" href="/tickets">Edit</a>
  </div>
</header>

<main class="container">
  <section class="card">
    <h2 style="margin-top:0;">Payment Preview</h2>
    <p class="muted" style="margin-top:6px;">Review the breakdown before selecting payment method.</p>

    <!-- Option B: no DB order yet, so no Order ID here -->
    <p class="muted" style="margin-top:6px;">
      Reservation Date:
      <b th:text="${#temporals.format(req.reservationDate, 'yyyy-MM-dd')}"></b>
    </p>

    <p class="muted" style="margin-top:10px;">
      Tickets:
      Adult <b th:text="${req.adultQty}"></b>,
      Student <b th:text="${req.studentQty}"></b>,
      Children <b th:text="${req.childQty}"></b>
    </p>

    <div class="hint" style="margin:12px 0 4px 0; font-size: 14px;">
      Want lower prices? <a href="/membership" class="link">Buy a membership</a> to unlock ticket discounts before checkout.
    </div>

    <table class="table" style="margin-top:14px;">
      <tr>
        <td class="muted">Total</td>
        <td class="right" th:text="${pricing.total}"></td>
      </tr>
      <tr>
        <td class="muted">Discount</td>
        <td class="right" th:text="${pricing.discount}"></td>
      </tr>
      <tr>
        <td class="muted">Tax (6%)</td>
        <td class="right" th:text="${pricing.tax}"></td>
      </tr>
      <tr>
        <td class="bold">Grand Total</td>
        <td class="right bold" th:text="${pricing.grandTotal}"></td>
      </tr>
    </table>

    <!-- Stripe Payment Integration -->
    <form th:action="@{/payment/confirm}" method="post" style="margin-top:16px;">
      <input type="hidden" name="paymentMethod" value="STRIPE"/>

      <div style="margin-top:14px; padding: 16px; background: rgba(37,99,235,.08); border-radius: 12px; border: 1px solid rgba(37,99,235,.2);">
        <div style="font-weight: 600; margin-bottom: 8px;">💳 Secure Payment with Stripe</div>
        <div style="font-size: 14px; color: var(--muted);">
          You will be redirected to Stripe's secure checkout page.<br/>
          We accept: Credit/Debit Cards, FPX (Online Banking), and GrabPay.
        </div>
      </div>

      <div class="actions">
        <a class="btn btn-outline" href="/tickets">Back</a>
        <button class="btn btn-primary" type="submit">Proceed to Payment</button>
      </div>
    </form>

  </section>
</main>

</body>
</html>
